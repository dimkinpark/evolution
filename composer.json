{
    "name": "evolutioncms/evolution",
    "description": "Evolution CMS is a Content Management System, ex MODX Evolution. ZetMedia fork (ZM) adds optional admin tooling on top.",
    "type": "project",
    "keywords": [
        "content",
        "CMS",
        "routing",
        "templating"
    ],
    "homepage": "https://evo-cms.com/",
    "license": "GPL-3.0+",
    "support": {
        "telegram": "https://t.me/evo_cms",
        "issues": "https://github.com/evocms-community/evolution/issues/",
        "source": "https://github.com/evocms-community/evolution/"
    },
    "config": {
        "vendor-dir": "vendor",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "require": {
        "php": ">=7.4",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.40"
    },
    "autoload": {
        "psr-4": {
            "ZM\\": "core/zm/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZM\\Tests\\": "core/zm/tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite",
        "lint": "Check code style without modifying files",
        "lint:fix": "Fix code style violations automatically",
        "analyse": "Run PHPStan static analysis",
        "check": "Run lint, analysis and tests in sequence"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
